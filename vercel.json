{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/auth/google/callback",
      "destination": "/api/calendar/callback"
    },
    {
      "source": "/auth/google",
      "destination": "/api/calendar/auth"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
