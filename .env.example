# TaskFlow Pro Environment Variables Example
# Set these in your .env (local) or Vercel Project Dashboard (Settings > Environment Variables)

# -------------------------------------------------------------
# 1. Email Service (Resend or SMTP)
# -------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=TaskFlow Pro <onboarding@resend.dev>

# Optional SMTP Fallback:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_app_password

# -------------------------------------------------------------
# 2. Authentication & Session Security
# -------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
APP_URL=https://task-manager-website-psi.vercel.app

# -------------------------------------------------------------
# 3. Google Sheets User Storage (MVP Database)
# -------------------------------------------------------------
# Create a Google Sheet, share it with your Service Account email as "Editor",
# and provide the Spreadsheet ID and Service Account credentials:
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# -------------------------------------------------------------
# 4. Google Calendar OAuth 2.0 Integration
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# -------------------------------------------------------------
# 5. Local Development Server
# -------------------------------------------------------------
PORT=8080
